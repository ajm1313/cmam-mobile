# CMAM Tracker Mobile - Environment Configuration Example
# Copy this file to .env and update with your values

# API Configuration
# For production, use the deployed API URL
API_BASE_URL=https://cmam-tracker-django-production.up.railway.app/api/v1

# For local development, use your local IP address
# Find your local IP: ipconfig (Windows) or ifconfig (Mac/Linux)
# LOCAL_API_BASE_URL=http://192.168.1.100:8000/api/v1

# App Configuration
APP_NAME=CMAM Tracker
APP_VERSION=1.0.0

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_PHOTO_UPLOAD=true
ENABLE_GPS_TRACKING=true

# Cache Configuration (in milliseconds)
CACHE_TTL_SHORT=300000
CACHE_TTL_MEDIUM=600000
CACHE_TTL_LONG=3600000

# Debug Mode
DEBUG_MODE=false
LOG_API_REQUESTS=false
